{
  "name": "@agent-wallet/api",
  "version": "0.0.0",
  "private": true,
  "description": "AWS SAM Lambda handlers for agent-wallet",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-policy-assets.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "jest",
    "dynamodb:up": "docker compose up -d",
    "dynamodb:down": "docker compose down",
    "seed": "tsx scripts/run-seed-local.ts",
    "seed:local": "tsx scripts/run-seed-local.ts",
    "seed:aws": "tsx scripts/seed.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "demo:reset:aws": "tsx scripts/demo-reset.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-eventbridge": "^3.1136.0",
    "@aws-sdk/client-kms": "^3.1136.0",
    "@aws-sdk/client-lambda": "^3.1136.0",
    "@aws-sdk/client-sfn": "^3.1136.0",
    "@aws-sdk/client-sns": "^3.1136.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@cedar-policy/cedar-wasm": "^4.13.0",
    "@stellar/stellar-sdk": "^17.1.0",
    "aws-jwt-verify": "^5.2.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.17.0",
    "dynalite": "^4.0.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
