# LimitX API
LIMITX_API_URL=https://gaq4ipibk8.execute-api.eu-north-1.amazonaws.com/dev
LIMITX_AGENT_ID=shopping-bot
LIMITX_API_KEY=shopping-bot-secret
LIMITX_MERCHANT=Amazon
LIMITX_SETTLEMENT_RAIL=chain

# Travel / vendor agent
LIMITX_TRAVEL_AGENT_ID=vendor-agent
LIMITX_TRAVEL_API_KEY=vendor-agent-secret
LIMITX_VENDOR_API_KEY=vendor-agent-secret

# AWS Bedrock (Strands demos) — eu-north-1
AWS_REGION=eu-north-1
# Optional override after: aws bedrock list-foundation-models --region eu-north-1
# BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# Browser (Playwright)
BROWSER_HEADLESS=1
ALLOW_ARBITRARY_PRODUCT_URL=0

# Prava Agentic Commerce
PRAVA_CLI=prava
