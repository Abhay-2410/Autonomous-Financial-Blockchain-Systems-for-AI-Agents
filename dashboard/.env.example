# Public URL of the agent-wallet API (API Gateway stage root, no trailing slash)
NEXT_PUBLIC_API_URL=https://gaq4ipibk8.execute-api.eu-north-1.amazonaws.com/dev

# Server-only (used by /api/pay) — must match Lambda OWNER_API_KEY
OWNER_API_KEY=limitx-owner-demo-key

# Optional: only needed if you call Prava from Next instead of Lambda.
# Prefer setting PravaSecretKey on the SAM stack (see infra/template.yaml).
# PRAVA_SECRET_KEY=sk_test_...
